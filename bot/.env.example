# 复制为 $BOT_DIR/.env 并 chmod 600。不要把填好的文件发给别人。
BOT_NAME=<你的机器人微信昵称>          # 群里别人 @ 的名字
WATCH_GROUPS=<群名1>,<群名2>          # 只在这些群回复，逗号分隔
LLM_BASE_URL=https://api.deepseek.com/v1   # 任意 OpenAI 兼容接口
LLM_API_KEY=<你的API_KEY>
LLM_MODEL=deepseek-chat
WX_DISPLAY=:2                         # 微信所在 X 屏幕
# 输入框坐标（截一张图量一下；见 README「坐标校准」）
INPUT_X=<x>
INPUT_Y=<y>
